{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/identity" } ]
      },
      "userprofile-route": {
        "ClusterId": "userprofile-cluster",
        "Match": { "Path": "/users/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/users" } ]
      },
      "post-route": {
        "ClusterId": "post-cluster",
        "Match": { "Path": "/posts/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/posts" } ]
      },
      "feed-route": {
        "ClusterId": "feed-cluster",
        "Match": { "Path": "/feed/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/feed" } ]
      },
      "socialgraph-route": {
        "ClusterId": "socialgraph-cluster",
        "Match": { "Path": "/social/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/social" } ]
      },
      "interaction-route": {
        "ClusterId": "interaction-cluster",
        "Match": { "Path": "/interactions/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/interactions" } ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/notifications" } ]
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": { "Path": "/search/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/search" } ]
      },
      "topic-route": {
        "ClusterId": "topic-cluster",
        "Match": { "Path": "/topics/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/topics" } ]
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": { "Path": "/media/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/media" } ]
      }
    },
    "Clusters": {
      "identity-cluster": { "Destinations": { "d1": { "Address": "http://identity-service:8081/" } } },
      "userprofile-cluster": { "Destinations": { "d1": { "Address": "http://userprofile-service:8082/" } } },
      "post-cluster": { "Destinations": { "d1": { "Address": "http://post-service:8083/" } } },
      "feed-cluster": { "Destinations": { "d1": { "Address": "http://feed-service:8084/" } } },
      "socialgraph-cluster": { "Destinations": { "d1": { "Address": "http://socialgraph-service:8085/" } } },
      "interaction-cluster": { "Destinations": { "d1": { "Address": "http://interaction-service:8086/" } } },
      "notification-cluster": { "Destinations": { "d1": { "Address": "http://notification-service:8087/" } } },
      "search-cluster": { "Destinations": { "d1": { "Address": "http://search-service:8088/" } } },
      "topic-cluster": { "Destinations": { "d1": { "Address": "http://topic-service:8089/" } } },
      "media-cluster": { "Destinations": { "d1": { "Address": "http://media-service:8090/" } } }
    }
  }
}
